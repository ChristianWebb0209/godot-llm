###############################################################################
# Core OpenAI settings (RAG + default Composer on OpenAI)
###############################################################################

# Used by /query (RAG agent) and (if request does not override api_key/base_url)
# by /composer/query.
#
# IMPORTANT: your OpenAI-compatible server may be implemented as a minimal
# `POST /v1/chat/completions` endpoint. The RAG /query path in this repo uses
# a different OpenAI endpoint (Responses API). So:
# - If you only use Godot Composer (backend profile `Godot Composer`), you can point
#   OPENAI_BASE_URL at your chat/completions server and ignore /query.
# - If you need RAG (/query), keep OPENAI_* pointing to a real OpenAI-compatible
#   Responses-capable host.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional: host/port override for the OpenAI-compatible API (usually not needed)
# OPENAI_BASE_URL=https://api.openai.com/v1


###############################################################################
# RAG settings
###############################################################################

RAG_DOCS_ROOT=../godot_knowledge_base/docs/4.6
RAG_TOP_K=5

# Base URL where this FastAPI service is running (used by testing.run).
RAG_BASE_URL=http://127.0.0.1:8000


###############################################################################
# Composer backend (fine-tuned Godot assistant)
#
# You can run Composer on OpenAI OR on any OpenAI-compatible host.
# If your host requires a key, set COMPOSER_MODEL + COMPOSER_API_KEY + COMPOSER_BASE_URL.
# If you want BOTH RAG + Composer to use the same host, set OPENAI_API_KEY/OPENAI_BASE_URL instead.
###############################################################################

# Model used by POST /composer/query.
# - On OpenAI: something like godot-composer or gpt-4.1-mini
# - On a compatible host: any model string your host accepts/ignores (often adapter-backed)
COMPOSER_MODEL=godot-composer

# Optional: Composer-specific credentials / endpoint.
# These are picked up by fine_tuning/testing/config.py as COMPOSER_API_KEY/BASE_URL.

# If running Composer on OpenAI only, you can leave these unset and it will fall back
# to OPENAI_API_KEY and OPENAI_BASE_URL.

# Host example (uncomment + replace with your real values):
#
# If your server does NOT enforce keys:
# COMPOSER_API_KEY=anything
# COMPOSER_BASE_URL=https://<YOUR_OPENAI_COMPATIBLE_ENDPOINT>/v1
#
# If your server enforces keys, set OPENAI_API_KEY/COMPOSER_API_KEY to that key.

# Or explicitly override for Composer (takes precedence over OPENAI_*):
# COMPOSER_API_KEY=your_composer_specific_key_if_different
# COMPOSER_BASE_URL=https://api.your-host.com/v1


###############################################################################
# How to run A/B tests (RAG vs Composer)
###############################################################################

# 1) Start the RAG service (from rag_service/):
#      python -m app.main
#
# 2) In another terminal, run tests (still from rag_service/):
#      python -m testing.run --backend both
#
#    This will:
#      - Call /query using RAG_MODEL (e.g. gpt-4.1-mini on OpenAI)
#      - Call /composer/query using COMPOSER_MODEL
#        and, if set, COMPOSER_API_KEY/COMPOSER_BASE_URL.
#
# 3) Optional: run LLM-as-judge on the combined results (needs OPENAI_API_KEY):
#      python -m testing.judge testing/results/run_YYYYMMDD_HHMMSS.json --openai --out testing/results/judge.json

